# --- Source documents: third-party copyright (ARAG/check24 etc.) ---
# Never publish the raw insurer PDFs or their verbatim extracted text.
data/inbox/
data/raw/
data/extracted/

# --- Market snapshots: dated price scans tied to a personal quote profile ---
# The change-tracking DB (scripts/snapshot.py). Keep local; not a shareable artifact.
data/snapshots/

# --- Personal offer data: per-user premium / chosen Stufe (not copyright, but personal) ---
# Use '/*' (NOT a trailing slash 'data/offers/'): git will not descend into an
# ignored directory, so a trailing-slash rule would also hide the tracked template
# and README below. Only the example + README are tracked; real offers are ignored.
data/offers/*
!data/offers/_example.json
!data/offers/README.md

# --- Personal quote profile: birthdate / zipcode (PII) ---
# The tracked twin config/check24-profile.example.json carries fake values; the real
# profile with your birthdate + zipcode stays out of git.
config/check24-profile.json

# --- Favorite notes: free-text typed via [N] (personal, not shareable) ---
# favorites.json stays PII-free (stem/tag/SB only); typed notes live in this sidecar.
config/favorite-notes.json

# --- Personal UI preferences (theme picked via [T]) ---
config/tui-prefs.json

# --- Local scratch ---
tmp/
*.log

# --- Python / uv ---
.venv/
__pycache__/
*.pyc
.uv-cache/

# --- macOS ---
.DS_Store

# --- Secrets (belt and suspenders; none expected in this repo) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# --- Tracked deliverables live in out/ (see .gitignore exception below) ---
# out/ is intentionally NOT ignored: it holds our own factual comparison
# (tariffs/*.json) and synthesized overview (vergleich.md, index.html).

# Exception: out/enriched/ carries the personal premium/Stufe merged in from
# data/offers/ — a per-user, machine-regenerable artifact, never a shareable
# deliverable. Keep it out of git even though the rest of out/ is tracked.
out/enriched/

# TUI screenshots embed the snapshot prices (tied to the personal profile) —
# regenerable via `tui.py --screenshot`, kept local.
out/screenshots/
