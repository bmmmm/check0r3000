/*
 * check0r3000 — Rechtsschutz-Vergleich
 * Textual CSS stylesheet — uses theme variables throughout; no hardcoded hex.
 */

/* ── App shell ──────────────────────────────────────────────────────────── */

App {
    background: $surface;
}

Header {
    background: $primary-darken-2;
    color: $text;
    text-style: bold;
    height: 2;
}

Footer {
    background: $primary-darken-2;
    color: $text-muted;
    height: 1;
}

#status-bar {
    height: 1;
    padding: 0 1;
    background: $surface-darken-1;
    color: $text-muted;
}

/* ── Tabs ───────────────────────────────────────────────────────────────── */

TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 0 1;
}

/* ── Filter input ───────────────────────────────────────────────────────── */

#filter-input {
    dock: top;
    height: 3;
    margin: 1 0 0 0;
    border: tall $primary-darken-2;
    background: $surface-darken-1;
    color: $text;
}

#filter-input:focus {
    border: tall $primary;
}

/* Data-availability legend above the Market table */
#market-legend {
    dock: top;
    height: 1;
    margin: 1 0 0 0;
    padding: 0 1;
    color: $text-muted;
    background: $surface-darken-1;
}

/* ── Favorites tab layout ───────────────────────────────────────────────── */

#fav-knockout {
    dock: top;
    height: auto;
    width: 1fr;
    margin: 1 0 0 0;
    padding: 0 1;
    color: $warning;
    background: $surface-darken-1;
}

#fav-layout {
    height: 1fr;
    margin-top: 1;
    layout: vertical;
}

/* Favorites board — full-width table, detail band stacked below */
#fav-table {
    width: 1fr;
    height: 1fr;
    border: tall $warning-darken-1;
    scrollbar-color: $warning-darken-1;
    scrollbar-background: $surface-darken-1;
}

#fav-detail {
    width: 1fr;
    height: 50%;
    border: tall $warning-darken-1;
    padding: 1 2;
    background: $surface-darken-1;
    margin-top: 1;
}

#fav-detail-content {
    color: $text;
}

/* Inline detail bands are hidden until the user toggles them with [d];
 * the ID rules above style them, this only sets the default visibility. */
.detail-band {
    display: none;
}

/* ── Market tab layout ──────────────────────────────────────────────────── */

#market-layout {
    height: 1fr;
    margin-top: 1;
    layout: vertical;
}

/* Main table — full width, detail band stacked below */
#market-table {
    width: 1fr;
    height: 1fr;
    border: tall $primary-darken-2;
    scrollbar-color: $primary-darken-2;
    scrollbar-background: $surface-darken-1;
}

DataTable > .datatable--header {
    background: $primary-darken-2;
    color: $text;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $primary-darken-1;
    color: $text;
}

DataTable > .datatable--even-row {
    background: $surface-darken-1;
}

DataTable > .datatable--odd-row {
    background: $surface;
}

/* Detail band below the table (toggled with [d]) */
#detail-panel {
    width: 1fr;
    height: 50%;
    border: tall $primary-darken-2;
    padding: 1 2;
    background: $surface-darken-1;
    margin-top: 1;
}

#detail-content {
    color: $text;
}

/* ── Diff tab ───────────────────────────────────────────────────────────── */

#diff-panel {
    height: 1fr;
    border: tall $primary-darken-2;
    padding: 1 2;
    background: $surface-darken-1;
    margin-top: 1;
}

#diff-content {
    color: $text;
}

/* ── Verlauf tab ────────────────────────────────────────────────────────── */

#verlauf-header {
    padding: 0 1;
    color: $text-muted;
}

#verlauf-layout {
    height: 1fr;
    margin-top: 1;
    layout: vertical;
}

#verlauf-table {
    width: 1fr;
    height: 1fr;
    border: tall $success-darken-2;
    scrollbar-color: $success-darken-2;
    scrollbar-background: $surface-darken-1;
}

#verlauf-detail {
    width: 1fr;
    height: 50%;
    border: tall $success-darken-2;
    padding: 1 2;
    background: $surface-darken-1;
    margin-top: 1;
}

#verlauf-detail-content {
    color: $text;
}

/* ── Magic Find tab ─────────────────────────────────────────────────────── */

#magic-header {
    padding: 0 1;
    color: $text-muted;
}

#magic-layout {
    height: 1fr;
    margin-top: 1;
    layout: vertical;
}

#magic-table {
    width: 1fr;
    height: 1fr;
    border: tall $accent-darken-2;
    scrollbar-color: $accent-darken-2;
    scrollbar-background: $surface-darken-1;
}

#magic-detail {
    width: 1fr;
    height: 50%;
    border: tall $accent-darken-2;
    padding: 1 2;
    background: $surface-darken-1;
    margin-top: 1;
}

#magic-detail-content {
    color: $text;
}

/* ── Confirm modal (download + analyze) ─────────────────────────────────── */

/* DeleteDataScreen reuses #confirm-box but is a distinct ModalScreen subclass,
   so it needs its own centering rule (ModalScreen.DEFAULT_CSS has none). */
ConfirmFetchScreen, DeleteDataScreen {
    align: center middle;
    background: $surface 60%;
}

#confirm-box {
    width: 74;
    height: auto;
    padding: 1 2;
    border: thick $warning;
    background: $surface-darken-1;
    color: $text;
}

#confirm-box Static {
    width: 1fr;
    height: auto;
}

/* ── Query-URL modal ([b]) ──────────────────────────────────────────────── */

QueryUrlScreen {
    align: center middle;
    background: $surface 60%;
}

#query-box {
    width: 84;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: thick $primary;
    background: $surface-darken-1;
    color: $text;
}

#query-box Static {
    width: 1fr;
    height: auto;
}

/* ── Query-edit modal ([e]) ─────────────────────────────────────────────── */

QueryEditScreen {
    align: center middle;
    background: $surface 60%;
}

#query-edit-box {
    width: 80;
    height: 85%;
    padding: 1 2;
    border: thick $primary;
    background: $surface-darken-1;
    color: $text;
}

#query-edit-head {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
}

#query-edit-warn {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
}

#query-edit-body {
    width: 1fr;
    height: 1fr;
    border: round $surface-lighten-2;
    padding: 0 1;
}

#query-edit-body .qe-input {
    width: 1fr;
    margin-bottom: 1;
}

#query-edit-body .qe-switch-row {
    width: 1fr;
    height: 3;
    align: left middle;
}

#query-edit-body .qe-switch-label {
    height: 3;
    content-align: left middle;
    margin-left: 1;
}

#query-edit-body .qe-readonly {
    width: 1fr;
    height: auto;
    margin-top: 1;
}

#query-edit-buttons {
    width: 1fr;
    height: auto;
    margin-top: 1;
    align: center middle;
}

#query-edit-buttons Button {
    margin: 0 1;
}

/* ── Query-save confirm modal (after [e]) ───────────────────────────────── */

QuerySaveConfirmScreen {
    align: center middle;
    background: $surface 60%;
}

#query-save-box {
    width: 76;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: thick $primary;
    background: $surface-darken-1;
    color: $text;
}

#query-save-box Static {
    width: 1fr;
    height: auto;
}

/* ── Open-source modal ([o]) ────────────────────────────────────────────── */

OpenSourceScreen {
    align: center middle;
    background: $surface 60%;
}

#open-box {
    width: 74;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: thick $primary;
    background: $surface-darken-1;
    color: $text;
}

#open-box Static {
    width: 1fr;
    height: auto;
}

/* ── Help modal ([?]) ───────────────────────────────────────────────────── */

HelpScreen {
    align: center middle;
    background: $surface 60%;
}

#help-box {
    width: 64;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: thick $primary;
    background: $surface-darken-1;
    color: $text;
}

#help-box Static {
    width: 1fr;
    height: auto;
}

/* ── Note editor modal ([N] on a favorite) ──────────────────────────────── */

NoteEditScreen {
    align: center middle;
    background: $surface 60%;
}

#note-box {
    width: 80;
    height: 60%;
    padding: 1 2;
    border: thick $warning;
    background: $surface-darken-1;
    color: $text;
}

#note-head {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
}

#note-input {
    width: 1fr;
    height: 1fr;
}

/* ── Full-text compare modal ([t]) ──────────────────────────────────────── */

CompareTextScreen {
    align: center middle;
    background: $surface 60%;
}

#fulltext-box {
    width: 90%;
    height: 85%;
    padding: 1 2;
    border: thick $primary;
    background: $surface-darken-1;
    color: $text;
}

#fulltext-head {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
}

#fulltext-body {
    width: 1fr;
    height: 1fr;
}

#fulltext-list {
    width: 40;
    height: 1fr;
    margin-right: 2;
    border: round $surface-lighten-2;
    background: $surface-darken-2;
}

#fulltext-detail-wrap {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
    border: round $surface-lighten-2;
}

#fulltext-detail {
    width: 1fr;
    height: auto;
}

/* ── Compare manager modal ([c] on the Vergleich tab) ───────────────────── */

CompareManagerScreen {
    align: center middle;
    background: $surface 60%;
}

#compare-mgr-box {
    width: 72;
    height: 80%;
    padding: 1 2;
    border: thick $primary;
    background: $surface-darken-1;
    color: $text;
}

#compare-mgr-head {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
}

#compare-mgr-list {
    width: 1fr;
    height: 1fr;
    border: round $surface-lighten-2;
    background: $surface-darken-2;
}

#needs-box {
    width: 64;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: thick $primary;
    background: $surface-darken-1;
    color: $text;
}

#needs-head {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
}

#needs-list {
    width: 1fr;
    height: auto;
    border: round $surface-lighten-2;
    background: $surface-darken-2;
}

/* ── Scrollbars ─────────────────────────────────────────────────────────── */

ScrollableContainer {
    scrollbar-color: $primary;
    scrollbar-background: $surface-darken-2;
    scrollbar-corner-color: $surface;
}

/* ── Boot splash (SplashScreen) ─────────────────────────────────────────── */

SplashScreen {
    align: center middle;
    background: $surface-darken-2;
}

#splash-canvas {
    width: auto;
    height: auto;
}
