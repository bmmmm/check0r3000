/*
 * check0r3000 — Rechtsschutz-Vergleich
 * Textual CSS stylesheet
 */

/* ── App shell ──────────────────────────────────────────────────────────── */

App {
    background: $surface;
}

Header {
    background: #1e3a5f;
    color: #a8d4ff;
    text-style: bold;
    height: 2;
}

Footer {
    background: #1e3a5f;
    color: #7aadcc;
    height: 1;
}

/* ── Tabs ───────────────────────────────────────────────────────────────── */

TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 0 1;
}

/* ── Filter input ───────────────────────────────────────────────────────── */

#filter-input {
    dock: top;
    height: 3;
    margin: 1 0 0 0;
    border: tall #1e3a5f;
    background: $surface-darken-1;
    color: $text;
}

#filter-input:focus {
    border: tall #5ba0d0;
}

/* Data-availability legend above the Market table */
#market-legend {
    dock: top;
    height: 1;
    margin: 1 0 0 0;
    padding: 0 1;
    color: $text-muted;
    background: $surface-darken-1;
}

/* ── Favorites tab layout ───────────────────────────────────────────────── */

#fav-knockout {
    dock: top;
    height: auto;
    width: 1fr;
    margin: 1 0 0 0;
    padding: 0 1;
    color: #c9a227;
    background: $surface-darken-1;
}

#fav-layout {
    height: 1fr;
    margin-top: 1;
    layout: vertical;
}

/* Favorites board — full-width table, detail band stacked below */
#fav-table {
    width: 1fr;
    height: 1fr;
    border: tall #8a6d1f;
    scrollbar-color: #8a6d1f;
    scrollbar-background: $surface-darken-1;
}

#fav-detail {
    width: 1fr;
    height: 50%;
    border: tall #8a6d1f;
    padding: 1 2;
    background: $surface-darken-1;
    margin-top: 1;
}

#fav-detail-content {
    color: $text;
}

/* Inline detail bands are hidden until the user toggles them with [d];
 * the ID rules above style them, this only sets the default visibility. */
.detail-band {
    display: none;
}

/* ── Market tab layout ──────────────────────────────────────────────────── */

#market-layout {
    height: 1fr;
    margin-top: 1;
    layout: vertical;
}

/* Main table — full width, detail band stacked below */
#market-table {
    width: 1fr;
    height: 1fr;
    border: tall #1e3a5f;
    scrollbar-color: #1e3a5f;
    scrollbar-background: $surface-darken-1;
}

DataTable > .datatable--header {
    background: #1e3a5f;
    color: #a8d4ff;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #264f78;
    color: $text;
}

DataTable > .datatable--even-row {
    background: $surface-darken-1;
}

DataTable > .datatable--odd-row {
    background: $surface;
}

/* Detail band below the table (toggled with [d]) */
#detail-panel {
    width: 1fr;
    height: 50%;
    border: tall #1e3a5f;
    padding: 1 2;
    background: $surface-darken-1;
    margin-top: 1;
}

#detail-content {
    color: $text;
}

/* ── Diff tab ───────────────────────────────────────────────────────────── */

#diff-panel {
    height: 1fr;
    border: tall #1e3a5f;
    padding: 1 2;
    background: $surface-darken-1;
    margin-top: 1;
}

#diff-content {
    color: $text;
}

/* ── Confirm modal (download + analyze) ─────────────────────────────────── */

ConfirmFetchScreen {
    align: center middle;
    background: $surface 60%;
}

#confirm-box {
    width: 74;
    height: auto;
    padding: 1 2;
    border: thick #c9a227;
    background: $surface-darken-1;
    color: $text;
}

#confirm-box Static {
    width: 1fr;
    height: auto;
}

/* ── Query-URL modal ([b]) ──────────────────────────────────────────────── */

QueryUrlScreen {
    align: center middle;
    background: $surface 60%;
}

#query-box {
    width: 84;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: thick #5ba0d0;
    background: $surface-darken-1;
    color: $text;
}

#query-box Static {
    width: 1fr;
    height: auto;
}

/* ── Scrollbars ─────────────────────────────────────────────────────────── */

ScrollableContainer {
    scrollbar-color: #5ba0d0;
    scrollbar-background: $surface-darken-2;
    scrollbar-corner-color: $surface;
}
